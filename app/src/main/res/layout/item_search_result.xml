<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Reference Title (Clicking this opens the verse in reader) -->
    <TextView
        android:id="@+id/tvSearchReference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="Genesis 1:1"
        android:textColor="#B71C1C"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Verse Preview Text (Non-clickable snippet so swiping results won't trigger jumps) -->
    <TextView
        android:id="@+id/tvSearchSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="In the beginning God created the heaven and the earth."
        android:textColor="#333333"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:textDirection="firstStrong" />

    <View
        android:id="@+id/vItemSearchDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#EEEEEE" />

</LinearLayout>
