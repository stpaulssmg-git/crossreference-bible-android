<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fontPickerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/vDragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <TextView
        android:id="@+id/tvFontPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Font Family"
        android:textColor="#1C1B1F"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/vFontDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <RadioGroup
        android:id="@+id/rgFontGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbFontSans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Sans-Serif (Modern / Clean)"
            android:textColor="#1C1B1F"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbFontSerif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Serif (Georgia / Literary Book Style)"
            android:textColor="#1C1B1F"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbFontMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Monospace (Fixed Pitch)"
            android:textColor="#1C1B1F"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbFontRounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Rounded (Casual / Trebuchet)"
            android:textColor="#1C1B1F"
            android:textSize="14sp" />

    </RadioGroup>

</LinearLayout>
