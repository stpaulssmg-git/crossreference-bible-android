<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/catalogContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FBF9F5">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/catalogTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#F5F0E6"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnCloseCatalog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Catalog"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#1C1B1F" />

        <TextView
            android:id="@+id/tvCatalogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Download Bibles (ebible.org)"
            android:textColor="#1C1B1F"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:id="@+id/vCatalogDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0D8C8" />

    <!-- Search Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#757575" />

            <EditText
                android:id="@+id/etCatalogSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search language or country (Swahili, French...)"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="#1C1B1F"
                android:textColorHint="#757575"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Catalog List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCatalogList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</LinearLayout>
