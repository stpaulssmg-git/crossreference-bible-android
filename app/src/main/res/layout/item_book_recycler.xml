<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Book Header Row -->
    <LinearLayout
        android:id="@+id/bookHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvBookName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Genesis"
            android:textColor="#1C1B1F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChapterCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50 Chapters"
            android:textColor="#757575"
            android:textSize="11sp" />

    </LinearLayout>

    <View
        android:id="@+id/vBookDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- Expandable Chapter Grid Container -->
    <LinearLayout
        android:id="@+id/chapterContainerParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:background="#FAF8F5"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chapterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
