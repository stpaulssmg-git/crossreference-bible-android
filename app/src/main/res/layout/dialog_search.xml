<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Top Navigation Modal Header Bar -->
    <RelativeLayout
        android:id="@+id/searchTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#F5F0E6">

        <ImageButton
            android:id="@+id/btnCloseSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_search"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1C1B1F" />

        <TextView
            android:id="@+id/tvSearchModalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnCloseSearch"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="@string/search_bible"
            android:textColor="#1C1B1F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActiveSearchTrans"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chapter_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/kjv_placeholder"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:id="@+id/vTopBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0D8C8" />

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Search Input Box Row -->
        <LinearLayout
            android:id="@+id/searchBoxRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_search_input">

            <ImageView
                android:id="@+id/ivSearchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/search_icon"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#757575" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#1C1B1F"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnClearQuery"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="#757575" />

        </LinearLayout>

        <!-- Direct Reference Jumps Container (Container for multiple matching books e.g. ma 3 2 -> Matthew 3:2, Mark 3:2, Malachi 3:2) -->
        <LinearLayout
            android:id="@+id/containerDirectJumps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Interactive Search Statistics Summary Bar -->
        <LinearLayout
            android:id="@+id/layoutSearchStatsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStatsPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kjv_prefix_placeholder"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatsOt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ot_stats_placeholder"
                android:textColor="#424242"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnToggleOtStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/plus_icon_placeholder"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/divider_pipe"
                android:textColor="#BDBDBD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStatsNt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nt_stats_placeholder"
                android:textColor="#424242"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnToggleNtStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/plus_icon_placeholder"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <!-- Result Status / Occurrences Line -->
        <TextView
            android:id="@+id/tvResultCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:text="@string/search_status_placeholder"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Page Navigation & Pagination Bar -->
        <LinearLayout
            android:id="@+id/layoutPaginationBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPrevPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/prev_page"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/page_indicator_placeholder"
                android:textColor="#2C2C2C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/next_page"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <View
            android:id="@+id/vSearchDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="#E0E0E0" />

        <!-- Results List (Limited to 10 verses max per page) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

    </LinearLayout>

</LinearLayout>
